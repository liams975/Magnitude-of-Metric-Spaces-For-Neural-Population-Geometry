   "source": [
    "def defect(D, p):\n",
    "    n = len(D)\n",
    "    P = np.eye(n) - np.ones((n, n)) / n\n",
    "    A = P @ (D ** p) @ P\n",
    "    w, V = np.linalg.eigh(A)\n",
    "    return w[-1], V[:, -1]"
   ]
  }
